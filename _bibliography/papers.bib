@article{park2025enhancing,
  abbr        = {IJETHE},
  bibtex_show = {true},
  title       = {Enhancing academic stress assessment through self-disclosure chatbots: effects on engagement, accuracy, and self-reflection},
  author      = {Park, Minyoung and Fels, Sidney and Seo, Kyoungwon},
  journal     = {International Journal of Educational Technology in Higher Education},
  volume      = {22},
  number      = {1},
  pages       = {28},
  year        = {2025},
  month       = {May},
  publisher   = {SpringerOpen},
  doi         = {10.1186/s41239-025-00527-z},
  html        = {https://educationaltechnologyjournal.springeropen.com/articles/10.1186/s41239-025-00527-z},
  website     = {https://hai.seoultech.ac.kr/research/demo-self-disclosure.html},
  abstract    = {This study investigates how self-disclosure chatbots—designed to share relevant experiences and thoughts—can enhance academic stress assessments by increasing student engagement, improving accuracy, and fostering deeper self-reflection. In a randomized experiment with 50 university students, participants interacted with either a self-disclosure (SD) or a non-self-disclosure (NSD) chatbot. The SD chatbot elicited significantly higher engagement (longer sessions and more words), slightly higher assessment accuracy against the SISCO Inventory of Academic Stress, and deeper self-reflection with more actionable stress-management strategies.},
  additional_info = {. **SSCI · JCR Top 0.1% · Q1**},
  dimensions  = {true},
  selected    = {true}
}

@inproceedings{park2025chi,
  abbr        = {CHI EA},
  bibtex_show = {true},
  title       = {How Self-Disclosing Chatbots Influence Student Engagement, Assessment Accuracy, and Self-Reflection in Academic Stress Assessment},
  author      = {Park, Minyoung and Park, Bogyeom and Seo, Kyoungwon},
  booktitle   = {Extended Abstracts of the CHI Conference on Human Factors in Computing Systems},
  series      = {CHI EA '25},
  pages       = {1--10},
  year        = {2025},
  month       = {April},
  publisher   = {Association for Computing Machinery},
  address     = {Yokohama, Japan},
  doi         = {10.1145/3706599.3719684},
  html        = {https://dl.acm.org/doi/10.1145/3706599.3719684},
  website     = {https://hai.seoultech.ac.kr/research/demo-self-disclosure.html},
  abstract    = {Academic stress poses substantial risks to students' well-being and academic performance, emphasizing the need for assessment tools that encourage deeper self-reflection while ensuring accuracy. This study explores how self-disclosure in chatbots can enhance student engagement, assessment accuracy, and self-reflection in academic stress assessments. Two chatbots were developed: a non-self-disclosing (NSD) chatbot and a self-disclosing (SD) chatbot, both integrating the SISCO Inventory of Academic Stress (SISCO-AS) questionnaire.},
  additional_info = {. **Late-Breaking Work**},
  selected    = {true}
}

