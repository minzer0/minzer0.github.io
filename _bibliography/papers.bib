@inproceedings{park2023passive,
  abbr        = {HCI Korea},
  bibtex_show = {true},
  title       = {Passive vs. Active: Which behavior is better for predicting at-risk students in online learning?},
  author      = {Park, Minyoung and Seo, Kyoungwon},
  booktitle   = {Proceedings of HCI Korea},
  pages       = {815--821},
  year        = {2023},
  html        = {https://www.dbpia.co.kr/journal/articleDetail?nodeId=NODE11229756},
  abstract    = {Using the Open University Learning Analytics Dataset, we compared how well passive behaviors (basic interactions with the learning system, such as homepage access) and active behaviors (interactions involving other users, such as forum participation) predict at-risk students. A random forest classifier trained on 3,994 students showed that passive behavior was the stronger predictor up to week 20, suggesting instructors can identify at-risk students early through basic engagement signals.}
}
