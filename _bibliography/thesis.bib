@mastersthesis{park2026thesis,
  abbr        = {M.S. Thesis},
  bibtex_show = {true},
  title       = {Designing empathetic self-disclosure in LLM-based chatbots to enhance students' self-reflection, engagement, and assessment accuracy in academic stress assessment},
  author      = {Park, Minyoung},
  school      = {Seoul National University of Science and Technology},
  type        = {Master's thesis},
  year        = {2026},
  month       = {February},
  pdf         = {Minyoung_Park_MS_Thesis.pdf},
  abstract    = {Accurate assessment of academic stress is critical for student well-being, but traditional self-report questionnaires and limited access to counseling make it difficult. This thesis proposes an empathetic self-disclosure (SD) chatbot designed to elicit deep self-reflection and improve assessment accuracy. In a between-subjects experiment with 50 university students, an SD chatbot was compared with a non-self-disclosure (NSD) chatbot, both structured around the SISCO Inventory of Academic Stress. Self-reflection depth was analyzed with Koole's self-reflection framework, and assessment accuracy was evaluated with a Corrective Retrieval-Augmented Generation (CRAG) pipeline using an LLM-as-a-Judge. The SD chatbot outperformed the NSD chatbot on all key metrics: deeper and more balanced self-reflection, higher engagement (longer sessions and more words), and higher assessment accuracy (ACC1 0.904 vs. 0.815).},
  annotation  = {Advisor: Prof. Kyoungwon Seo}
}
